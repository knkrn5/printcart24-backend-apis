{
  "name": "printcart24",
  "version": "1.0.0",
  "description": "This is a application helping students to print their documents and buy stationery at one place.",
  "main": "server.js",
  "type": "module",
  "author": "Nilanjan Haldar",
  "license": "ISC",
  "scripts": {
    "dev": "node --env-file=.env --watch server.js",
    "start": "node --env-file=.env server.js",
    "admin:seed": "node --env-file=.env scripts/initializeAdmin.script.js",
    "locations:seed": "node --env-file=.env scripts/seedIndiaLocations.script.js",
    "print-services:seed": "node --env-file=.env scripts/seedPrintServices.script.js",
    "print-service-pricing:seed": "node --env-file=.env scripts/seedPrintServicePricing.script.js",
    "stationery-products:seed": "node --env-file=.env scripts/seedStationeryProducts.script.js",
    "discount-coupons:seed": "node --env-file=.env scripts/seedCoupons.script.js",
    "s3:sync": "node --env-file=.env scripts/syncImages.script.js",
    "binding:audit": "node --env-file=.env scripts/auditBindingOptions.script.js",
    "binding:clear": "node --env-file=.env --env-file=.env.binding.clear scripts/auditBindingOptions.script.js",
    "binding-toggles:dry-run": "node --env-file=.env scripts/migrateBindingToggles.script.js",
    "binding-toggles:apply": "node --env-file=.env scripts/migrateBindingToggles.script.js --apply",
    "cleanup:deleted-users": "node --env-file=.env scripts/cleanupDeletedUsers.script.js",
    "order:seed": "node --env-file=.env scripts/seedTestOrder.script.js",
    "test:cart-edit-flow": "node --env-file=.env scripts/testCartEditCustomizationFlow.script.js",
    "test:cart-edit-ttl": "node --env-file=.env scripts/testCartEditTtlFlow.script.js",
    "test:cart-edit-single": "node --env-file=.env scripts/testCartEditSingleFilter.script.js",
    "test:binding-color-label": "node --env-file=.env scripts/testBindingColorLabel.script.js",
    "test:binding-selections": "node --env-file=.env scripts/testBindingSelections.script.js",
    "test:lean-default-bug": "node --env-file=.env scripts/testLeanDefaultBug.script.js",
    "test:cart-cleanup": "node --env-file=.env scripts/testAvailableDocumentCleanup.script.js",
    "test:binding-toggle-filter": "node --env-file=.env scripts/testBindingToggleFilter.script.js",
    "test:binding-api-display": "node --env-file=.env scripts/testBindingAPIDisplay.script.js",
    "test:bulk-clear": "node --env-file=.env scripts/testBulkClearDocuments.script.js",
    "verify:color-quality-filter": "node --env-file=.env scripts/verifyColorFilteredPaperQualities.script.js"
  },
  "imports": {
    "#configs/*": "./configs/*.config.js",
    "#controllers/*": "./controllers/*.controller.js",
    "#middlewares/*": "./middlewares/*.middleware.js",
    "#models/*": "./models/*.model.js",
    "#routes/*": "./routes/*.route.js",
    "#services/*": "./services/*.service.js",
    "#utils/*": "./utils/*.util.js",
    "#validations/*": "./validations/*.validation.js",
    "#scripts/*": "./scripts/*.script.js",
    "#constants/*": "./constants/*.constants.js",
    "#root/*": "./*.js"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "prettier": "^3.8.1",
    "socket.io-client": "^4.8.3"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1016.0",
    "@aws-sdk/s3-request-presigner": "^3.1130.0",
    "bcrypt": "^6.0.0",
    "chalk": "^5.6.2",
    "cors": "^2.8.6",
    "envalid": "^8.1.1",
    "express": "^5.2.1",
    "firebase-admin": "^13.7.0",
    "http-status": "^2.1.0",
    "joi": "^18.0.2",
    "jsonwebtoken": "^9.0.3",
    "mime-types": "^3.0.2",
    "moment-timezone": "^0.6.0",
    "mongoose": "^9.3.1",
    "multer": "^2.1.1",
    "node-cron": "^4.2.1",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.19.1",
    "razorpay": "^2.9.6",
    "redis": "^5.11.0",
    "socket.io": "^4.8.3",
    "uuid": "^14.0.0"
  }
}
